# ============================================================
# Backend Server
# ============================================================
FASTAPI_HOST=127.0.0.1
# DILIGENT is single-user and localhost-only. Network deployment is unsupported.
FASTAPI_PORT=7690
RELOAD=false
# Set to false to hide backend logs; defaults to true when absent.
BACKEND_LOGS_VISIBLE=true

# ============================================================
# Frontend Server
# ============================================================
UI_HOST=127.0.0.1
UI_PORT=9847
VITE_API_BASE_URL=/api

# ============================================================
# Optional Dependencies
# ============================================================
OPTIONAL_DEPENDENCIES=true

# ============================================================
# Database Contract
# ============================================================
DATABASE_BACKEND=sqlite
DATABASE_SQLITE_PATH=
DATABASE_CONNECT_TIMEOUT=10
DATABASE_WRITE_BATCH_SIZE=1000
DATABASE_READ_PAGE_SIZE=1000

# ============================================================
# PostgreSQL URL (required only when DATABASE_BACKEND=postgresql)
# ============================================================
DATABASE_URL=postgresql+psycopg://postgres:password@127.0.0.1:5432/diligent
