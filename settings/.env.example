# ============================================================
# Backend Server
# ============================================================
FASTAPI_HOST=127.0.0.1
# DILIGENT is single-user and localhost-only. Network deployment is unsupported.
FASTAPI_PORT=7690
RELOAD=false
# Set to false to hide backend logs; defaults to true when absent.
BACKEND_LOGS_VISIBLE=true

# ============================================================
# Frontend Server
# ============================================================
UI_HOST=127.0.0.1
UI_PORT=9847
VITE_API_BASE_URL=/api

# ============================================================
# Resource Location
# ============================================================
# Source-mode resource root. Relative paths resolve from the repository root.
# The embedded SQLite database defaults to <resource-root>/database.db.
# Packaged desktop mode uses its runtime/data roots instead.
DILIGENT_RESOURCES_PATH=app/resources

# ============================================================
# Database Mode
# ============================================================
# true  = use the embedded SQLite database
# false = use the external PostgreSQL connection below
EMBEDDED_DATABASE=true

# ============================================================
# External Database Connection
# ============================================================
# When provided, DATABASE_URL seeds the host, port, database name, username,
# and password. Explicit DATABASE_* values below override URL parts.
DATABASE_URL=
DATABASE_ENGINE=postgresql+psycopg
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=DILIGENT
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# ============================================================
# External Database Security And Performance
# ============================================================
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_CONNECT_TIMEOUT=30
DATABASE_WRITE_BATCH_SIZE=1000
DATABASE_READ_PAGE_SIZE=1000
# Optional external key-material file. Leave blank to keep it under the resource root.
DILIGENT_ACCESS_KEY_MATERIAL_FILE=
