# ============================================================
# Backend Server
# ============================================================
FASTAPI_HOST=127.0.0.1
# DILIGENT is single-user and localhost-only. Network deployment is unsupported.
FASTAPI_PORT=7690
RELOAD=false
# Set to false to hide backend logs; defaults to true when absent.
BACKEND_LOGS_VISIBLE=true

# ============================================================
# Frontend Server
# ============================================================
UI_HOST=127.0.0.1
UI_PORT=9847
VITE_API_BASE_URL=/api

# ============================================================
# Optional Dependencies
# ============================================================
OPTIONAL_DEPENDENCIES=true

# ============================================================
# Database Mode
# ============================================================
EMBEDDED_DATABASE=true

# ============================================================
# Database Connection
# ============================================================
DATABASE_URL=
DATABASE_ENGINE=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=diligent
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_CONNECT_TIMEOUT=10

# ============================================================
# Database Performance
# ============================================================
DATABASE_INSERT_BATCH_SIZE=1000
DATABASE_INSERT_COMMIT_INTERVAL=5
DATABASE_SELECT_PAGE_SIZE=2000
