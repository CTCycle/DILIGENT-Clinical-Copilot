# ============================================================
# Backend Server
# ============================================================
FASTAPI_HOST=127.0.0.1
# DILIGENT is single-user and localhost-only. Network deployment is unsupported.
FASTAPI_PORT=7690
RELOAD=false

# ============================================================
# Frontend Server
# ============================================================
UI_HOST=127.0.0.1
UI_PORT=9847
# Browser API base; /api uses the same-origin dev/preview proxy.
VITE_API_BASE_URL=/api
# Comma-separated exact HTTP(S) origins allowed to call the source-mode API.
# Leave blank for the default same-origin setup.
CORS_ALLOW_ORIGINS=

# ============================================================
# Data Location
# ============================================================
# Source-mode data root. Relative paths resolve from the repository root.
# Packaged desktop mode uses its runtime/data roots instead.
DILIGENT_DATA_PATH=data

# Optional external key-material file. Leave blank to keep it under the data root.
DILIGENT_ACCESS_KEY_MATERIAL_FILE=
