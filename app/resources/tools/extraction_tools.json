{
  "version": "1.0.0",
  "tools": [
    {
      "name": "search_drug_by_regex",
      "version": "1.0.0",
      "description": "Deterministically finds likely drug mentions in clinical text. Returns structured matches with exact spans, line numbers, source section, pattern id, confidence, and warnings.",
      "supported_section_types": ["therapy", "anamnesis"],
      "default_regex_profile": "clinical_drug_v1",
      "allowed_configurable_profiles": ["clinical_drug_v1"],
      "parameters": {
        "type": "object",
        "properties": {
          "text": {"type": "string", "description": "Source text to scan."},
          "source_section": {"type": "string", "description": "Canonical source section label."},
          "profile": {"type": "string", "description": "Regex profile id."}
        },
        "required": ["text", "source_section"]
      }
    },
