{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DILIGENT Clinical Copilot",
  "version": "3.0.0",
  "identifier": "io.github.ctcycle.diligent",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
