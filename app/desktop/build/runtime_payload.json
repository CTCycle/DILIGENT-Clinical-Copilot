    { "source": "app/resources/catalogs/drug_matching.json", "destination": "app/resources/catalogs/drug_matching.json", "required": true },
    { "source": "app/resources/catalogs/language_detection.json", "destination": "app/resources/catalogs/language_detection.json", "required": true },
    { "source": "app/resources/catalogs/llm_generation_policies.json", "destination": "app/resources/catalogs/llm_generation_policies.json", "required": true },
