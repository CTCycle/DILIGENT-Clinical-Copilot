{
  "manifest": "text_normalization",
  "version": 2,
  "description": "Deterministic text normalization vocabulary.",
  "entries": [
    {
      "domain": "text_normalization",
      "category": "noisy_phrases",
      "key": "default",
      "locale": "und",
      "priority": 100,
      "values": ["dal", "entrambi e il", "rialzo a"],
      "metadata": {"case_sensitive": false, "match_mode": "phrase"}
    },
    {
      "domain": "text_normalization",
      "category": "generic_drug_terms",
      "key": "default",
      "locale": "und",
      "priority": 100,
      "values": ["therapy", "treatment", "medications", "drug", "drugs"],
      "metadata": {"case_sensitive": false, "match_mode": "token"}
    },
    {
      "domain": "text_normalization",
      "category": "drug_non_mentions",
      "key": "default",
      "locale": "und",
      "priority": 100,
      "values": ["in riserva", "al bisogno", "se necessario", "dopo", "paziente femmina", "paziente maschio"],
      "metadata": {"case_sensitive": false, "match_mode": "phrase"}
    },
    {
      "domain": "text_normalization",
      "category": "matching_stopwords",
      "key": "default",
      "locale": "und",
      "priority": 100,
      "values": ["and", "or", "with", "without", "tablet", "tablets", "capsule", "capsules", "solution", "mg", "ml", "cpr", "gtt", "estratto", "secco", "lingual", "retard", "ret", "sr", "xl", "xr", "cr", "er", "ir", "forte", "caps", "sir", "drag", "gran", "polv", "per", "os", "sc", "s.c.", "iv", "im", "inhal", "inh"],
      "metadata": {"case_sensitive": false, "match_mode": "token"}
    },
    {
      "domain": "text_normalization",
      "category": "source_reference_terms",
      "key": "default",
      "locale": "und",
      "priority": 100,
      "values": ["livertox", "rxnav"],
      "metadata": {"case_sensitive": false, "match_mode": "token"}
    }
  ]
}
