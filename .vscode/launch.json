{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}/app/server",
      "env": {
        "HF_ASSETS_CACHE": "${workspaceFolder}/runtimes/cache/huggingface/assets",
        "HF_HOME": "${workspaceFolder}/runtimes/cache/huggingface",
        "HF_HUB_CACHE": "${workspaceFolder}/runtimes/cache/huggingface/hub",
        "HUGGINGFACE_HUB_CACHE": "${workspaceFolder}/runtimes/cache/huggingface/hub",
        "PYTHONPYCACHEPREFIX": "${workspaceFolder}/runtimes/cache/python"
      },
      "python": "${workspaceFolder}/app/server/.venv/Scripts/python.exe"
    },
    {
      "name": "Debug: Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "server.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "7690"
      ],
      "jinja": true,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Uvicorn running on (http://\\S+)",
        "uriFormat": "%s/docs"
      },
      "envFile": "${workspaceFolder}/settings/.env",
      "env": {
        "CARGO_TARGET_DIR": "${workspaceFolder}/runtimes/cache/cargo/target",
        "COVERAGE_FILE": "${workspaceFolder}/runtimes/cache/coverage/.coverage",
        "HF_ASSETS_CACHE": "${workspaceFolder}/runtimes/cache/huggingface/assets",
        "HF_HOME": "${workspaceFolder}/runtimes/cache/huggingface",
        "HF_HUB_CACHE": "${workspaceFolder}/runtimes/cache/huggingface/hub",
        "HUGGINGFACE_HUB_CACHE": "${workspaceFolder}/runtimes/cache/huggingface/hub",
        "MYPY_CACHE_DIR": "${workspaceFolder}/runtimes/cache/mypy",
        "NPM_CONFIG_CACHE": "${workspaceFolder}/runtimes/cache/npm",
        "PIP_CACHE_DIR": "${workspaceFolder}/runtimes/cache/pip",
        "PLAYWRIGHT_BROWSERS_PATH": "${workspaceFolder}/runtimes/cache/playwright",
        "PYTHONPYCACHEPREFIX": "${workspaceFolder}/runtimes/cache/python",
        "PYTEST_ADDOPTS": "--basetemp=${workspaceFolder}/runtimes/cache/pytest/basetemp -o cache_dir=${workspaceFolder}/runtimes/cache/pytest",
        "RUFF_CACHE_DIR": "${workspaceFolder}/runtimes/cache/ruff",
        "UV_CACHE_DIR": "${workspaceFolder}/runtimes/cache/uv"
      },
      "cwd": "${workspaceFolder}/app",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${workspaceFolder}/app/server/.venv/Scripts/python.exe"
    },
    {
      "name": "Debug: Frontend",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/app/client",
      "env": {
        "HF_ASSETS_CACHE": "${workspaceFolder}/runtimes/cache/huggingface/assets",
        "HF_HOME": "${workspaceFolder}/runtimes/cache/huggingface",
        "HF_HUB_CACHE": "${workspaceFolder}/runtimes/cache/huggingface/hub",
        "HUGGINGFACE_HUB_CACHE": "${workspaceFolder}/runtimes/cache/huggingface/hub",
        "NPM_CONFIG_CACHE": "${workspaceFolder}/runtimes/cache/npm",
        "PLAYWRIGHT_BROWSERS_PATH": "${workspaceFolder}/runtimes/cache/playwright"
      },
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "9847"
      ],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(http://\\S+)",
        "uriFormat": "%s"
      },
      "autoAttachChildProcesses": false,
      "internalConsoleOptions": "neverOpen",
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug: Frontend + Backend",
      "configurations": [
        "Debug: Backend",
        "Debug: Frontend"
      ],
      "stopAll": true
    }
  ]
}
